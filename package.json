{
  "name": "antigravity-assistant",
  "displayName": "Antigravity Assistant",
  "description": "Автономный агент Gemini 3.8 Flash для VS Code",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity.openFullChat",
        "title": "Antigravity: Открыть чат на весь экран",
        "icon": "$(screen-full)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravity.openFullChat",
          "when": "view == antigravity.chatView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-sidebar",
          "title": "Antigravity",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "antigravity-sidebar": [
        {
          "type": "webview",
          "id": "antigravity.chatView",
          "name": "Чат Antigravity"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.1.2",
    "ws": "^8.18.0"
  }
}